--- a/firmware/platformio.ini
+++ b/firmware/platformio.ini
@@ -1,17 +1,34 @@
-; ATEM Tally - M5StickS3 firmware
+; ATEM Web Tally - M5StickS3 firmware
 ;
-; NOTE: The StickS3 (ESP32-S3-PICO-1-N8R8) is new (Jan 2026). Verify that your
-; installed M5Unified version supports it (>= the release that added StickS3
-; board detection). If auto-detection misbehaves, check M5Unified's issues for
-; an explicit board define.
+; Bench-validated on M5StickS3 (ESP32-S3-PICO-1-N8R8), M5Unified 0.2.21 / M5GFX 0.2.28.
+;
+; IMPORTANT (StickS3):
+;  - There is no stock PlatformIO board def for the StickS3; we build for the
+;    StampS3 (same chip) and tell M5GFX which board it really is with
+;    -DM5GFX_BOARD=26 (board_M5StickS3 in M5GFX's boards.hpp). Without it,
+;    M5GFX's autodetect never probes the StickS3 panel and the screen stays dark.
+;  - M5GFX caches the detected board in NVS. Before your FIRST upload, erase
+;    the flash once so a stale detection can't override the define:
+;        pio run -t erase && pio run -t upload
+;  - Flashing: hold the side button until the green LED flashes (download
+;    mode), then upload. --before=no_reset avoids the S3 USB re-enumeration race.
+;  - Serial output is on the native USB port (ARDUINO_USB_CDC_ON_BOOT=1).
 
 [env:m5sticks3]
 platform = espressif32
-board = m5stack-stamps3        ; ESP32-S3 w/ 8MB flash - closest stock board def; adjust if M5 publishes an official StickS3 def
+board = m5stack-stamps3
 framework = arduino
 monitor_speed = 115200
-build_flags =
-    -DCORE_DEBUG_LEVEL=0
 lib_deps =
-    m5stack/M5Unified@^0.2.2
+    m5stack/M5Unified@^0.2.12
     bblanchon/ArduinoJson@^7.0.0
+build_flags =
+    -DCORE_DEBUG_LEVEL=3
+    -DARDUINO_USB_MODE=1
+    -DARDUINO_USB_CDC_ON_BOOT=1
+    -DM5GFX_BOARD=26
+upload_speed = 460800
+upload_flags =
+    --before=no_reset
+; If auto-detection picks the wrong port, pin it:
+; upload_port = /dev/cu.usbmodem2101
